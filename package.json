    "@typescript-eslint/parser": "^8.56.1",
    "allure-playwright": "^3.4.5",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1"
  },
  "dependencies": {
    "@faker-js/faker": "^10.3.0",
